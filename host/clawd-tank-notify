#!/usr/bin/env python3
"""clawd-tank-notify — Claude Code hook handler for Clawd Tank notifications.

Reads hook payload from stdin, forwards to the Clawd Tank daemon.
Starts the daemon if not running.
"""

import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

# Ensure clawd_tank_daemon package is importable
sys.path.insert(0, str(Path(__file__).parent))

CLAWD_DIR = Path.home() / ".clawd-tank"
PID_PATH = CLAWD_DIR / "daemon.pid"
# POSIX: the Unix socket itself. Windows has no AF_UNIX, so this is the file the
# daemon publishes its loopback port and shared secret in — see
# clawd_tank_daemon/socket_server.py, which has to agree on the name.
SOCKET_PATH = CLAWD_DIR / ("endpoint.json" if sys.platform == "win32" else "sock")


def _pid_alive(pid: int) -> bool:
    """Check if a process exists. Raises OSError if it cannot be determined.

    Inlined rather than imported from clawd_tank_daemon.process_utils because
    this script is deployed standalone and must stay stdlib-only.
    """
    if sys.platform == "win32":
        # os.kill(pid, 0) raises nothing for a process that has already exited
        # on Windows, so a handle to it is not enough — check the exit code.
        import ctypes

        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        # Declared explicitly: ctypes otherwise truncates the HANDLE to an int.
        kernel32.OpenProcess.argtypes = (ctypes.c_uint32, ctypes.c_int, ctypes.c_uint32)
        kernel32.OpenProcess.restype = ctypes.c_void_p
        handle = kernel32.OpenProcess(0x1000, False, pid)  # QUERY_LIMITED_INFO
        if not handle:
            return False
        try:
            code = ctypes.c_ulong()
            if not kernel32.GetExitCodeProcess(ctypes.c_void_p(handle),
                                               ctypes.byref(code)):
                return False
            return code.value == 259  # STILL_ACTIVE
        finally:
            kernel32.CloseHandle(ctypes.c_void_p(handle))
    os.kill(pid, 0)  # Check if process exists
    return True


def is_daemon_running() -> bool:
    """Check if the daemon is alive via PID file."""
    if not PID_PATH.exists():
        return False
    try:
        pid = int(PID_PATH.read_text().strip())
        alive = _pid_alive(pid)
    except (ValueError, ProcessLookupError, PermissionError, OSError):
        alive = False
    if not alive:
        # Stale PID file
        PID_PATH.unlink(missing_ok=True)
    return alive


def start_daemon() -> None:
    """Start the daemon in the background."""
    CLAWD_DIR.mkdir(parents=True, exist_ok=True)

    # Start daemon as a detached subprocess. The log file is opened in a
    # with block so it is closed promptly even if Popen raises.
    with open(CLAWD_DIR / "daemon.log", "a") as log_file:
        subprocess.Popen(
            [sys.executable, "-m", "clawd_tank_daemon.daemon"],
            cwd=str(Path(__file__).parent),
            stdout=log_file,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )

    # Wait for socket to appear
    for _ in range(50):  # 5 seconds max
        if SOCKET_PATH.exists():
            return
        time.sleep(0.1)

    print("Warning: daemon may not have started", file=sys.stderr)


def send_to_daemon(payload: dict) -> None:
    """Send a JSON message to the daemon.

    POSIX connects straight to the Unix socket. Windows has no AF_UNIX: the
    daemon publishes a loopback port and a shared secret in SOCKET_PATH, and the
    secret goes out as the first line to authorise the connection.
    """
    from clawd_tank_daemon.protocol import hook_payload_to_daemon_message

    msg = hook_payload_to_daemon_message(payload)
    if msg is None:
        return  # Irrelevant hook event

    if sys.platform == "win32":
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    else:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(3.0)
        if sys.platform == "win32":
            endpoint = json.loads(SOCKET_PATH.read_text(encoding="utf-8"))
            sock.connect(("127.0.0.1", endpoint["port"]))
            sock.sendall(endpoint["token"].encode("utf-8") + b"\n")
        else:
            sock.connect(str(SOCKET_PATH))
        # Messages are newline-delimited so the server can use readline()
        # for a reliable message boundary.
        sock.sendall(json.dumps(msg).encode("utf-8") + b"\n")
    # json.JSONDecodeError and KeyError cover a torn or stale endpoint file and
    # can only arise on the Windows branch, so the POSIX failure set is unchanged.
    except (ConnectionRefusedError, FileNotFoundError, socket.timeout,
            json.JSONDecodeError, KeyError) as e:
        print(f"Failed to send to daemon: {e}", file=sys.stderr)
        # Exit 0: notifications are best-effort; a non-zero exit would
        # surface a noisy error in Claude Code for a non-critical failure.
        sys.exit(0)
    finally:
        sock.close()


def main():
    # Read hook payload from stdin
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            sys.exit(0)
        payload = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"Invalid JSON from hook: {e}", file=sys.stderr)
        sys.exit(1)

    # Ensure daemon is running
    if not is_daemon_running():
        start_daemon()

    # Forward to daemon
    send_to_daemon(payload)


if __name__ == "__main__":
    main()
